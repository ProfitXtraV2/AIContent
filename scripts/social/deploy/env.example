# /etc/px-social/env — the check's settings and secrets (chmod 600, owner px-social).
# Names only here; the values exist in the guest alone and never leave it (I1).

# Postiz, on the internal port only (published to 127.0.0.1, never through the tunnel)
POSTIZ_API_URL=http://127.0.0.1:5000/api/public/v1
POSTIZ_API_KEY=
# V4 decides: html (paragraphs in <p>, like the Postiz editor) or text
POSTIZ_CONTENT_FORMAT=html

# GitHub App px-publishing-check (contents write, pull requests read, issues read)
PX_SOCIAL_APP_ID=
PX_SOCIAL_INSTALLATION_ID=
PX_SOCIAL_APP_KEY_FILE=/etc/px-social/github-app.pem

# WebPortals, read only: the publisher's record (.published-state.json)
WEBPORTALS_READ_TOKEN=

# The data clone of AIContent main and the check's own state
PX_SOCIAL_DATA=/var/lib/px-social/AIContent
PX_SOCIAL_DB=/var/lib/px-social/state.sqlite

# The guest-side switch: brands the setup person turned on after Nikolay confirmed (rollout step 10)
PX_SOCIAL_ENABLED_BRANDS=
# The pinned issue "Social control" (/stop-now, /lift)
PX_SOCIAL_CONTROL_ISSUE=

# 1 = plan and log hand-overs, create nothing in Postiz. 0 only after the launch gates.
DRY_RUN=1

# Exact values the key scan looks for in every new commit (flow 14)
SOCIAL_SECRET_ENV_NAMES=POSTIZ_API_KEY,WEBPORTALS_READ_TOKEN
