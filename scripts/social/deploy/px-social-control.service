[Unit]
Description=Social control loop: stop now, lift, channels disabled in the tool (tech spec flow 7)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=px-social
Group=px-social
EnvironmentFile=/etc/px-social/env
WorkingDirectory=/var/lib/px-social
ExecStart=/usr/bin/flock -w 240 /run/px-social/lock /usr/bin/python3 /opt/px-social/current/scripts/social/control.py
TimeoutStartSec=10min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/px-social /run/px-social
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
